enum Role {
  buyer
  seller
  admin
}

enum SellerStatus {
  pending
  approved
  rejected
}

enum ProductStatus {
  active
  inactive
  deleted
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  fullName     String?
  passwordHash String?
  googleId     String?      @unique
  githubId     String?      @unique
  role         Role         @default(buyer)
  sellerStatus SellerStatus?
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  products     Product[]
  cartItems    CartItem[]
  orders       Order[]
}

model Product {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  description  String?
  price        Float
  images       String[]
  stock        Int           @default(0)
  status       ProductStatus @default(active)
  category     String
  ratingAvg    Float         @default(0)
  ratingCount  Int           @default(0)
  freeShipping Boolean       @default(false)
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  cartItems    CartItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model CartItem {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
}

model Order {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Json
  subtotal Float
  shippingCost Float
  total Float
  status String @default("pending")
  fullName String
  address String
  city String
  zip String
  country String
  deliveryMethod String
  createdAt DateTime @default(now())
}

generator client {          // "which SDK to build from this schema, and where to put it"
  provider = "prisma-client" // think: codegen, like graphql-codegen producing typed hooks
  output   = "../generated/prisma"
}


datasource db {
  provider = "postgresql"   // the dialect — like choosing fetch vs axios, but for SQL flavors
}