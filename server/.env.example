# Boot-required vars (no code fallback — app fails fast without these)
API_URL=http://localhost:3000
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DATABASE_URL=postgresql://user:password@localhost:5432/db
NODE_ENV=development
# Vars with code fallbacks (safe to omit)
PORT=3000
CLIENT_URL=http://localhost:3001
# Payments (Stripe) — omit to keep payments disabled (config reports false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shipping rates — omit to keep live rates disabled (config reports false)
SHIPPING_API_KEY=
SHIPPING_API_URL=
# Marketplace commission applied to seller net earnings (0-1). Default 0.1
COMMISSION_RATE=0.1
